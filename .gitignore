/tools/experiments/quake2_submission_20261012/**/*.elf
/tools/experiments/quake2_submission_20261012/**/*.rbf
/tools/experiments/quake2_submission_20261012/**/*.rbf_r
/tools/experiments/quake2_submission_20261012/**/*.sof
