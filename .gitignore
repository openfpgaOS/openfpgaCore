/tools/experiments/quake2_tiny_audio_timing_20261013/**/*.sof
# Unqualified full-sweep raw reports remain local; retain recipes and summaries.
/tools/experiments/quake2_tiny_audio_20261013/sweep/seeds/
/tools/experiments/quake2_tiny_audio_20261013/sweep/results.json
/tools/experiments/quake2_tiny_audio_20261013/sweep/map.log
