.target
# Build output
build/

# Quartus intermediate files
db/
incremental_db/
*.rpt
*.summary
*.qws
*.bak

# Archives
*.zip

# Firmware build outputs
src/firmware/**/*.o
src/firmware/**/*.d
src/firmware/**/*.elf
src/firmware/os/.last_target
src/firmware/**/*.bin
src/firmware/**/*.map
src/firmware/**/*.lst
src/firmware/**/*.mif

# FPGA build outputs
src/fpga/output_files/
src/fpga/db/
src/fpga/incremental_db/
src/fpga/simulation/
src/fpga/greybox_tmp/
src/fpga/*.qws
src/fpga/*.bak
src/fpga/targets/*/firmware.mif
!src/fpga/targets/pocket/firmware.mif

# Verilator build artifacts
src/fpga/test/obj_dir*/
src/fpga/test/*.vcd
*.vcd

# Verilator-generated test source variants (produced on demand by
# the test Makefile's sed rules)
src/fpga/test/io_sdram_test.v
src/fpga/test/psram_test.sv
src/fpga/test/psram_cram0_drv_test.sv
src/fpga/test/psram_controller_test.v
src/fpga/test/psram_cram0_test.v

# Quartus per-seed logs (kept as loose files outside db/)
src/fpga/targets/*/output_files/seed_*_compile.log
src/fpga/targets/*/output_files/seed_*_fit.log
src/fpga/targets/*/output_files/seed_*_sta.log
src/fpga/targets/*/output_files/seed_map.log
src/fpga/targets/*/output_files/*.jdi
src/fpga/targets/*/simulation/

# SignalTap captures
*.stp

# Build tools (compiled from source)
tools/reverse_bits
tools/sf2_to_ofsf

# Editor/IDE
*.swp
*.swo
*~
.vscode/
.idea/
.claude/

# Python
.venv/
__pycache__/

# VexRiscv source trees (only generated .v needed)
src/fpga/vendor/vexriscv/VexRiscv/
src/fpga/vendor/vexriscv/VexiiRiscv/
!src/fpga/vendor/vexriscv/VexiiRiscv

# macOS
.DS_Store
._*
src/fpga/vendor/vexriscv/VexiiRiscv_Full.v

# Editor scratch
.codex

