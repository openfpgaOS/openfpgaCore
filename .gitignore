.target
.variant
# Build output
build/
# Release bundles (make package/release TARGET=mister → core zip + Downloader DB)
releases/

# Quartus intermediate files
db/
incremental_db/
*.rpt
*.summary
*.qws
*.bak

# Archives
*.zip

# Firmware build outputs
src/firmware/**/*.o
src/firmware/**/*.d
src/firmware/**/*.elf
src/firmware/os/bld/
src/firmware/**/*.bin
src/firmware/**/*.map
src/firmware/**/*.lst
src/firmware/**/*.mif

# App build outputs (src/apps/<name>/)
src/apps/**/*.o
src/apps/**/*.d
src/apps/**/*.elf
src/apps/**/*.map

# FPGA build outputs
src/fpga/output_files/
src/fpga/db/
src/fpga/incremental_db/
src/fpga/simulation/
src/fpga/greybox_tmp/
src/fpga/*.qws
src/fpga/*.bak
src/fpga/targets/*/firmware.mif

# Per-target Quartus output (bitstreams, .last_variant, reports — regenerated by `make build`)
src/fpga/targets/*/output_files/
# Per-job isolated build dirs (bld/<job>/: generated qsf + db/ + output_files/)
src/fpga/targets/*/bld/

# Verilator build artifacts
src/fpga/test/obj_dir*/
src/fpga/obj_dir*/
src/fpga/test/*.vcd
*.vcd

# Verilator-generated test source variants (produced on demand by
# the test Makefile's sed rules)
src/fpga/test/io_sdram_test.v
src/fpga/test/psram_test.sv
src/fpga/test/psram_cram0_drv_test.sv
src/fpga/test/psram_controller_test.v
src/fpga/test/psram_cram0_test.v

# Quartus per-seed logs (kept as loose files outside db/)
src/fpga/targets/*/output_files/seed_*_compile.log
src/fpga/targets/*/output_files/seed_*_fit.log
src/fpga/targets/*/output_files/seed_*_sta.log
src/fpga/targets/*/output_files/seed_map.log
src/fpga/targets/*/output_files/*.jdi
src/fpga/targets/*/simulation/
# Regenerated per-build artifacts (Quartus STA dump + build_id PRE_FLOW MIF)
src/fpga/targets/*/sta_output.log
src/fpga/targets/*/apf/build_id.mif

# SignalTap captures
*.stp

# Build tools / generated binaries (compiled from source on demand)
tools/reverse_bits
tools/sf2_to_ofsf
src/fpga/targets/pocket/chip32/loader.bin
src/emulator/ofemu
src/emulator/test_save

# Locally-supplied Altera Quartus tarballs for the quartus-image bakes.
# Intel/Altera Quartus EULA forbids redistribution — keep these out of the repo.
# pocket (25.1, installer):     Quartus-*-linux.tar
# mister (17.0.x, pre-extract): altera-17*.tar* / intelFPGA*17*.tar*
tools/**/Quartus-*-linux.tar
tools/**/altera-17*.tar*
tools/**/intelFPGA*17*.tar*

# Persistent sbt/ivy/coursier cache for the vexii container (host-owned).
tools/.vexii-home/

# Editor/IDE
*.swp
*.swo
*~
.vscode/
.idea/
.claude/

# Python
.venv/
__pycache__/

# VexRiscv source trees (only generated .v needed)
src/fpga/vendor/vexriscv/VexRiscv/
src/fpga/vendor/vexriscv/VexiiRiscv/
!src/fpga/vendor/vexriscv/VexiiRiscv

# Persistent sbt/ivy/coursier dep cache for the VexiiRiscv generation container
tools/.vexii-home/

# macOS
.DS_Store
._*
src/fpga/vendor/vexriscv/VexiiRiscv_Full.v

# Editor scratch
.codex

# Regenerated by the MiSTer framework's PRE_FLOW script on every compile
src/fpga/targets/mister/build_id.v
