--- a/src/fpga/common/os30/geometry_bram_import.v
+++ b/src/fpga/common/os30/geometry_bram_import.v
@@ -0,0 +1,114 @@
+// Read an immutable leased LOAD result directly into the GPU clip payload.
+// The owner grants a synchronous BRAM port; PRIME is required after grant
+// because the shared-port address mux changes on that edge. No cache write
+// happens here: the GPU commits only a complete, validated result.
+module geometry_bram_import (
+    input wire clk,
+    input wire reset,
+    input wire start,
+    input wire [31:0] token,
+    input wire [4:0] source_slot,
+    input wire [31:0] u_offset, v_offset, context_flags,
+    output wire busy,
+    output reg done, error,
+    output wire view_req,
+    output reg [31:0] view_token,
+    output reg [4:0] view_source,
+    output wire [7:0] view_addr,
+    output reg view_done,
+    input wire view_grant, view_error,
+    input wire [31:0] view_data,
+    output reg [31:0] clip_x, clip_y, clip_w, tex_u, tex_v, depth,
+    output reg [15:0] rgb565
+);
+    localparam IDLE=2'd0, REQUEST=2'd1, PRIME=2'd2, CAPTURE=2'd3;
+    reg [1:0] state;
+    reg [2:0] row;
+    reg [31:0] held_u_offset, held_v_offset, held_flags;
+    wire [31:0] converted;
+    wire conversion_error;
+    wire signed [31:0] raw_u = {{16{view_data[15]}}, view_data[15:0]};
+    wire signed [31:0] raw_v = {{16{view_data[31]}}, view_data[31:16]};
+    wire signed [31:0] u_units = raw_u - $signed(held_u_offset) + (held_flags[17] ? 32'sd16 : 32'sd0);
+    wire signed [31:0] v_units = raw_v - $signed(held_v_offset) + (held_flags[17] ? 32'sd16 : 32'sd0);
+    wire invalid_context = context_flags[31:19] != 0 ||
+        (context_flags[16] && (u_offset > 32'd524280 || v_offset > 32'd524280 ||
+                              u_offset[2:0] != 0 || v_offset[2:0] != 0));
+    wire bad_capture = ((row == 0 || row == 1 || row == 3 || row == 4) && conversion_error) ||
+        (row == 3 && (view_data[31] || view_data[30:0] == 0 || view_data >= 32'h46fffe00)) ||
+        (row == 7 && view_data != 0);
+    assign busy = state != IDLE;
+    assign view_req = state == REQUEST;
+    assign view_addr = {row, view_source};
+    geometry_import_convert convert (.value(view_data), .depth_mode(row == 4),
+        .result(converted), .error(conversion_error));
+    always @(posedge clk) begin
+        done <= 0;
+        error <= 0;
+        view_done <= 0;
+        if (reset) begin
+            state <= IDLE;
+            row <= 0;
+            view_token <= 0;
+            view_source <= 0;
+            held_u_offset <= 0;
+            held_v_offset <= 0;
+            held_flags <= 0;
+            clip_x <= 0; clip_y <= 0; clip_w <= 0;
+            tex_u <= 0; tex_v <= 0; depth <= 0; rgb565 <= 0;
+        end else case (state)
+            IDLE: if (start) begin
+                if (invalid_context) begin
+                    done <= 1;
+                    error <= 1;
+                end else begin
+                    view_token <= token;
+                    view_source <= source_slot;
+                    held_u_offset <= u_offset;
+                    held_v_offset <= v_offset;
+                    held_flags <= context_flags;
+                    row <= 0;
+                    state <= REQUEST;
+                end
+            end
+            REQUEST: begin
+                if (view_error) begin
+                    done <= 1;
+                    error <= 1;
+                    state <= IDLE;
+                end else if (view_grant) state <= PRIME;
+            end
+            PRIME: state <= CAPTURE;
+            CAPTURE: begin
+                if (bad_capture) begin
+                    view_done <= 1;
+                    done <= 1;
+                    error <= 1;
+                    state <= IDLE;
+                end else begin
+                    case (row)
+                        0: clip_x <= converted;
+                        1: clip_y <= converted;
+                        3: clip_w <= converted;
+                        4: depth <= converted;
+                        5: begin
+                            tex_u <= held_flags[16] ? (u_units << 11) : 32'd0;
+                            tex_v <= held_flags[16] ? (v_units << 11) : 32'd0;
+                        end
+                        6: rgb565 <= held_flags[18] ? {view_data[7:3], view_data[15:10], view_data[23:19]} : held_flags[15:0];
+                        default: ;
+                    endcase
+                    if (row == 7) begin
+                        view_done <= 1;
+                        done <= 1;
+                        state <= IDLE;
+                    end else begin
+                        row <= row + 1'b1;
+                        state <= PRIME;
+                    end
+                end
+            end
+            default: state <= IDLE;
+        endcase
+    end
+endmodule
--- a/src/fpga/common/os30/geometry_import_convert.v
+++ b/src/fpga/common/os30/geometry_import_convert.v
@@ -0,0 +1,50 @@
+// Direct LOAD-result import: binary32 power-of-two scale and signed RNE.
+// This is the existing app's FE_TONEAREST contract, not a general FPU.
+// Unsupported nonfinite and nonzero subnormal inputs fail before cache writes.
+module geometry_import_convert (
+    input wire [31:0] value,
+    input wire depth_mode,
+    output reg [31:0] result,
+    output reg error
+);
+    reg [23:0] mantissa;
+    reg [32:0] magnitude, remainder, half;
+    integer shift_count, right_count;
+    always @* begin
+        result = 0;
+        error = 0;
+        mantissa = {1'b1, value[22:0]};
+        magnitude = 0;
+        remainder = 0;
+        half = 0;
+        shift_count = 0;
+        right_count = 0;
+        if (value[30:23] == 8'hff ||
+            (value[30:23] == 0 && value[22:0] != 0)) begin
+            error = 1;
+        end else if (depth_mode && (value[31] || value[30:0] <= 31'h30800000)) begin
+            result = 32'd1;
+        end else if (depth_mode && value[30:0] >= 31'h3fffffff) begin
+            result = 32'h7fffff80;
+        end else if (value[30:23] != 0) begin
+            // value = mantissa * 2^(exponent - 150).
+            shift_count = {24'd0, value[30:23]} + (depth_mode ? 30 : 8) - 150;
+            if (shift_count >= 0) begin
+                if (shift_count > 8) error = 1;
+                else magnitude = {9'd0, mantissa} << shift_count;
+            end else begin
+                right_count = -shift_count;
+                if (right_count <= 24) begin
+                    magnitude = {9'd0, mantissa} >> right_count;
+                    remainder = {9'd0, mantissa} & ((33'd1 << right_count) - 1'b1);
+                    half = 33'd1 << (right_count - 1);
+                    if (remainder > half || (remainder == half && magnitude[0]))
+                        magnitude = magnitude + 1'b1;
+                end
+            end
+            if ((!value[31] && magnitude > 33'h07fffffff) ||
+                (value[31] && magnitude > 33'h080000000)) error = 1;
+            result = value[31] ? -magnitude[31:0] : magnitude[31:0];
+        end
+    end
+endmodule
--- a/src/fpga/common/os30/geometry_import_view.v
+++ b/src/fpga/common/os30/geometry_import_view.v
@@ -0,0 +1,147 @@
+// BIM2: two immutable snapshots decouple the raw LOAD producer from GPU work.
+// One synchronous raw-result port fills bank A; an independent RAM port feeds
+// the GPU. The source lease ends after copying, not after ordered GPU release.
+module geometry_import_view (
+ input wire clk, reset, consumer_reset,
+ input wire result_success, result_valid, producer_active,
+ input wire [5:0] result_count,
+ input wire claim, clear_error, producer_rejected,
+ input wire [31:0] claim_token,
+ output reg [31:0] generation,
+ output wire leased,
+ output reg error,
+ output reg [31:0] claim_result,
+ output wire [1:0] free_banks,
+ input wire cpu_view_active,
+ input wire [7:0] cpu_view_addr,
+ output wire cpu_view_block,
+ output wire [7:0] result_addr,
+ input wire [31:0] result_data,
+ input wire gpu_req,
+ input wire [31:0] gpu_token,
+ input wire [4:0] gpu_src,
+ input wire [7:0] gpu_addr,
+ output wire gpu_grant, gpu_error,
+ output wire [31:0] gpu_data,
+ input wire gpu_read_done, gpu_release, gpu_fault,
+ input wire [31:0] gpu_release_token,
+ output reg owner
+);
+ localparam COPY_IDLE=2'd0, COPY_WAIT_CPU=2'd1, COPY_PRIME=2'd2, COPY_RUN=2'd3;
+ reg [1:0] copy_state;
+ reg copy_bank, gpu_read_bank;
+ reg [7:0] copy_issue_addr, copy_capture_addr;
+ reg [1:0] bank_valid, bank_ready;
+ reg [31:0] bank_token [0:1];
+ reg [5:0] bank_count [0:1];
+ // 512x32 uses two Cyclone V M10Ks. Port A writes snapshots; port B is
+ // synchronous and independent of the producer/canonical CPU result view.
+ (* ramstyle = "M10K, no_rw_check" *) reg [31:0] snapshot_mem [0:511];
+ reg [31:0] snapshot_q;
+ assign gpu_data = snapshot_q;
+ assign leased = copy_state != COPY_IDLE;
+ assign free_banks = ~bank_valid;
+ assign cpu_view_block = leased;
+ wire copy_owns_raw_port = copy_state == COPY_PRIME || copy_state == COPY_RUN;
+ assign result_addr = copy_owns_raw_port ? copy_issue_addr : cpu_view_addr;
+
+ wire gpu_match0 = bank_valid[0] && bank_token[0] == gpu_token;
+ wire gpu_match1 = bank_valid[1] && bank_token[1] == gpu_token;
+ wire gpu_match = gpu_match0 || gpu_match1;
+ wire gpu_bank = gpu_match1;
+ wire gpu_source_valid = {1'b0,gpu_src} < bank_count[gpu_bank];
+ wire reject_request = gpu_req && !owner && (!gpu_match || !gpu_source_valid);
+ wire accept_request = gpu_req && !owner && gpu_match && gpu_source_valid && bank_ready[gpu_bank];
+ assign gpu_grant = !reset && !consumer_reset && (owner || accept_request);
+ assign gpu_error = !reset && !consumer_reset && reject_request;
+
+ wire duplicate_claim = (bank_valid[0] && bank_token[0] == claim_token) ||
+                        (bank_valid[1] && bank_token[1] == claim_token);
+ wire invalid_claim = !result_valid || producer_active || result_success ||
+                      claim_token != generation || result_count == 0 || result_count > 32;
+ wire no_free_bank = &bank_valid;
+ wire claim_bank = bank_valid[0]; // Prefer bank0; called only when one is free.
+ wire accept_claim = claim && !leased && !invalid_claim && !duplicate_claim && !no_free_bank;
+ wire release_match0 = bank_valid[0] && bank_token[0] == gpu_release_token;
+ wire release_match1 = bank_valid[1] && bank_token[1] == gpu_release_token;
+ wire release_match = release_match0 || release_match1;
+ wire release_bank = release_match1;
+ wire release_safe = release_match && bank_ready[release_bank] &&
+                     !(owner && gpu_read_bank == release_bank) &&
+                     !(gpu_req && gpu_token == gpu_release_token);
+
+ always @(posedge clk) begin
+  if (!reset && !consumer_reset && copy_state == COPY_RUN)
+   snapshot_mem[{copy_bank,copy_capture_addr}] <= result_data;
+  // Ownership changes after the grant edge. The existing GPU importer PRIME
+  // state supplies the extra edge before consuming this synchronous output.
+  snapshot_q <= snapshot_mem[{gpu_read_bank,gpu_addr}];
+ end
+
+ always @(posedge clk) begin
+  if (reset) begin
+   generation <= 0;
+   copy_state <= COPY_IDLE;
+   copy_bank <= 0; gpu_read_bank <= 0;
+   copy_issue_addr <= 0; copy_capture_addr <= 0;
+   bank_valid <= 0; bank_ready <= 0;
+   bank_token[0] <= 0; bank_token[1] <= 0;
+   bank_count[0] <= 0; bank_count[1] <= 0;
+   owner <= 0; error <= 0; claim_result <= 0;
+  end else begin
+   // Raw generations advance even while old snapshots are queued/consumed.
+   if (result_success) generation <= generation + 1'b1;
+   if (consumer_reset) begin
+    copy_state <= COPY_IDLE;
+    bank_valid <= 0; bank_ready <= 0;
+    owner <= 0; error <= 0; claim_result <= 0;
+   end else begin
+    if (clear_error) error <= 0;
+    if (accept_request) begin owner <= 1; gpu_read_bank <= gpu_bank; end
+    if (gpu_read_done) owner <= 0;
+    if (reject_request || gpu_fault || producer_rejected) error <= 1;
+    if (gpu_release) begin
+     if (release_safe) begin bank_valid[release_bank] <= 0; bank_ready[release_bank] <= 0; end
+     else error <= 1;
+    end
+    case (copy_state)
+     COPY_WAIT_CPU: if (!cpu_view_active) begin
+      // Switch the address mux only after the accepted CPU burst drains.
+      copy_issue_addr <= 0;
+      copy_state <= COPY_PRIME;
+     end
+     COPY_PRIME: begin
+      // This edge issues raw word0. First capture is the next edge.
+      copy_capture_addr <= 0;
+      copy_issue_addr <= 1;
+      copy_state <= COPY_RUN;
+     end
+     COPY_RUN: begin
+      if (copy_capture_addr == 8'hff) begin
+       bank_ready[copy_bank] <= 1;
+       copy_state <= COPY_IDLE;
+      end else begin
+       copy_capture_addr <= copy_issue_addr;
+       if (copy_issue_addr != 8'hff) copy_issue_addr <= copy_issue_addr + 1'b1;
+      end
+     end
+     default: ;
+    endcase
+    if (claim) begin
+     // Rejection is expected flow control, not a protocol fault. A new
+     // attempt always replaces the mailbox; stale success cannot survive.
+     claim_result <= {26'd0,leased,invalid_claim,no_free_bank,duplicate_claim,2'b00};
+     if (accept_claim) begin
+      claim_result <= {30'd0,claim_bank,1'b1};
+      bank_valid[claim_bank] <= 1;
+      bank_ready[claim_bank] <= 0;
+      bank_token[claim_bank] <= claim_token;
+      bank_count[claim_bank] <= result_count;
+      copy_bank <= claim_bank;
+      copy_state <= COPY_WAIT_CPU;
+     end
+    end
+   end
+  end
+ end
+endmodule
