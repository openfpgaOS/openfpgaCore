+// Read an immutable leased LOAD result directly into the GPU clip payload.
+// The owner grants a synchronous BRAM port; PRIME is required after grant
+// because the shared-port address mux changes on that edge. No cache write
+// happens here: the GPU commits only a complete, validated result.
+module geometry_bram_import (
+    input wire clk,
+    input wire reset,
+    input wire start,
+    input wire [31:0] token,
+    input wire [4:0] source_slot,
+    input wire [31:0] u_offset, v_offset, context_flags,
+    output wire busy,
+    output reg done, error,
+    output wire view_req,
+    output reg [31:0] view_token,
+    output reg [4:0] view_source,
+    output wire [7:0] view_addr,
+    output reg view_done,
+    input wire view_grant, view_error,
+    input wire [31:0] view_data,
+    output reg [31:0] clip_x, clip_y, clip_w, tex_u, tex_v, depth,
+    output reg [15:0] rgb565
+);
+    localparam IDLE=2'd0, REQUEST=2'd1, PRIME=2'd2, CAPTURE=2'd3;
+    reg [1:0] state;
+    reg [2:0] row;
+    reg [31:0] held_u_offset, held_v_offset, held_flags;
+    wire [31:0] converted;
+    wire conversion_error;
+    wire signed [31:0] raw_u = {{16{view_data[15]}}, view_data[15:0]};
+    wire signed [31:0] raw_v = {{16{view_data[31]}}, view_data[31:16]};
+    wire signed [31:0] u_units = raw_u - $signed(held_u_offset) + (held_flags[17] ? 32'sd16 : 32'sd0);
+    wire signed [31:0] v_units = raw_v - $signed(held_v_offset) + (held_flags[17] ? 32'sd16 : 32'sd0);
+    wire invalid_context = context_flags[31:19] != 0 ||
+        (context_flags[16] && (u_offset > 32'd524280 || v_offset > 32'd524280 ||
+                              u_offset[2:0] != 0 || v_offset[2:0] != 0));
+    wire bad_capture = ((row == 0 || row == 1 || row == 3 || row == 4) && conversion_error) ||
+        (row == 3 && (view_data[31] || view_data[30:0] == 0 || view_data >= 32'h46fffe00)) ||
+        (row == 7 && view_data != 0);
+    assign busy = state != IDLE;
+    assign view_req = state == REQUEST;
+    assign view_addr = {row, view_source};
+    geometry_import_convert convert (.value(view_data), .depth_mode(row == 4),
+        .result(converted), .error(conversion_error));
+    always @(posedge clk) begin
+        done <= 0;
+        error <= 0;
+        view_done <= 0;
+        if (reset) begin
+            state <= IDLE;
+            row <= 0;
+            view_token <= 0;
+            view_source <= 0;
+            held_u_offset <= 0;
+            held_v_offset <= 0;
+            held_flags <= 0;
+            clip_x <= 0; clip_y <= 0; clip_w <= 0;
+            tex_u <= 0; tex_v <= 0; depth <= 0; rgb565 <= 0;
+        end else case (state)
+            IDLE: if (start) begin
+                if (invalid_context) begin
+                    done <= 1;
+                    error <= 1;
+                end else begin
+                    view_token <= token;
+                    view_source <= source_slot;
+                    held_u_offset <= u_offset;
+                    held_v_offset <= v_offset;
+                    held_flags <= context_flags;
+                    row <= 0;
+                    state <= REQUEST;
+                end
+            end
+            REQUEST: begin
+                if (view_error) begin
+                    done <= 1;
+                    error <= 1;
+                    state <= IDLE;
+                end else if (view_grant) state <= PRIME;
+            end
+            PRIME: state <= CAPTURE;
+            CAPTURE: begin
+                if (bad_capture) begin
+                    view_done <= 1;
+                    done <= 1;
+                    error <= 1;
+                    state <= IDLE;
+                end else begin
+                    case (row)
+                        0: clip_x <= converted;
+                        1: clip_y <= converted;
+                        3: clip_w <= converted;
+                        4: depth <= converted;
+                        5: begin
+                            tex_u <= held_flags[16] ? (u_units << 11) : 32'd0;
+                            tex_v <= held_flags[16] ? (v_units << 11) : 32'd0;
+                        end
+                        6: rgb565 <= held_flags[18] ? {view_data[7:3], view_data[15:10], view_data[23:19]} : held_flags[15:0];
+                        default: ;
+                    endcase
+                    if (row == 7) begin
+                        view_done <= 1;
+                        done <= 1;
+                        state <= IDLE;
+                    end else begin
+                        row <= row + 1'b1;
+                        state <= PRIME;
+                    end
+                end
+            end
+            default: state <= IDLE;
+        endcase
+    end
+endmodule
