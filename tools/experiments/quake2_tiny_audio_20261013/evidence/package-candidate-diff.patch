+    if (!reset_n) begin
+        state <= IDLE;
+        voice <= 0;
+        address <= 0;
+        remaining <= 0;
+        canceled <= 0;
+        data_read_address <= 0;
+        tag_read_address <= 0;
+        fill_word <= 0;
+        fill_error <= 0;
+        transient_valid <= 0;
+        transient_error <= 0;
+    end else begin
+        if (state != IDLE && (!cache_enable || invalidating_current))
+            canceled <= 1'b1;
+        case (state)
+            IDLE: if (accepted) begin
+                voice <= request_voice;
+                address <= s_araddr;
+                remaining <= s_arlen;
+                tag_read_address <= request_voice;
+                transient_valid <= 1'b0;
+                canceled <= invalidate_valid && invalidate_voice == request_voice;
