+                        transient_valid <= 1'b1;
+                        transient_error <= 2'b00;
+                    end
+                    state <= DATA_WAIT;
+                end else begin
+                    fill_word <= 3'd0;
+                    fill_error <= 2'b00;
+                    transient_valid <= 1'b0;
+                    state <= FILL_AR;
