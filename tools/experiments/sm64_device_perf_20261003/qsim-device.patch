+/* Functional voice lifetime for profiling the real SM64 sequence/predecode
+ * code. PCM mixing, interrupt service and kernel-call cost are NOT modeled. */
+static void sm64_voice_advance(qenv *E) {
+    uint64_t now=5000000u+(E->flips*1000000ull+29)/30;
+    for(unsigned i=0;i<32;i++) {
+        __typeof__(E->sm64_voice[0]) *v=&E->sm64_voice[i];
+        uint64_t dt=now-v->last_us;v->last_us=now;
+        if(!v->active)continue;
+        uint64_t n=dt*48000u*v->rate+v->fraction;
+        v->position+=n/1000000u;v->fraction=n%1000000u;
+        if(v->loop_end>v->loop_start) {
+            uint64_t end=(uint64_t)v->loop_end<<16;
+            uint64_t span=(uint64_t)(v->loop_end-v->loop_start)<<16;
+            if(v->position>=end)v->position=((uint64_t)v->loop_start<<16)+(v->position-end)%span;
+        } else if(v->position>=((uint64_t)v->count<<16)) {
+            v->active=0;E->sm64_ended|=1u<<i;
+        }
+    }
+}
