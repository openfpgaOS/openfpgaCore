+// BIM2: two immutable snapshots decouple the raw LOAD producer from GPU work.
+// One synchronous raw-result port fills bank A; an independent RAM port feeds
+// the GPU. The source lease ends after copying, not after ordered GPU release.
+module geometry_import_view (
+ input wire clk, reset, consumer_reset,
+ input wire result_success, result_valid, producer_active,
+ input wire [5:0] result_count,
+ input wire claim, clear_error, producer_rejected,
+ input wire [31:0] claim_token,
+ output reg [31:0] generation,
+ output wire leased,
+ output reg error,
+ output reg [31:0] claim_result,
+ output wire [1:0] free_banks,
+ input wire cpu_view_active,
+ input wire [7:0] cpu_view_addr,
+ output wire cpu_view_block,
+ output wire [7:0] result_addr,
+ input wire [31:0] result_data,
+ input wire gpu_req,
+ input wire [31:0] gpu_token,
+ input wire [4:0] gpu_src,
+ input wire [7:0] gpu_addr,
+ output wire gpu_grant, gpu_error,
+ output wire [31:0] gpu_data,
+ input wire gpu_read_done, gpu_release, gpu_fault,
+ input wire [31:0] gpu_release_token,
+ output reg owner
+);
+ localparam COPY_IDLE=2'd0, COPY_WAIT_CPU=2'd1, COPY_PRIME=2'd2, COPY_RUN=2'd3;
+ reg [1:0] copy_state;
+ reg copy_bank, gpu_read_bank;
+ reg [7:0] copy_issue_addr, copy_capture_addr;
+ reg [1:0] bank_valid, bank_ready;
+ reg [31:0] bank_token [0:1];
+ reg [5:0] bank_count [0:1];
+ // 512x32 uses two Cyclone V M10Ks. Port A writes snapshots; port B is
+ // synchronous and independent of the producer/canonical CPU result view.
+ (* ramstyle = "M10K, no_rw_check" *) reg [31:0] snapshot_mem [0:511];
+ reg [31:0] snapshot_q;
+ assign gpu_data = snapshot_q;
+ assign leased = copy_state != COPY_IDLE;
+ assign free_banks = ~bank_valid;
+ assign cpu_view_block = leased;
+ wire copy_owns_raw_port = copy_state == COPY_PRIME || copy_state == COPY_RUN;
+ assign result_addr = copy_owns_raw_port ? copy_issue_addr : cpu_view_addr;
+
+ wire gpu_match0 = bank_valid[0] && bank_token[0] == gpu_token;
+ wire gpu_match1 = bank_valid[1] && bank_token[1] == gpu_token;
+ wire gpu_match = gpu_match0 || gpu_match1;
+ wire gpu_bank = gpu_match1;
+ wire gpu_source_valid = {1'b0,gpu_src} < bank_count[gpu_bank];
+ wire reject_request = gpu_req && !owner && (!gpu_match || !gpu_source_valid);
+ wire accept_request = gpu_req && !owner && gpu_match && gpu_source_valid && bank_ready[gpu_bank];
+ assign gpu_grant = !reset && !consumer_reset && (owner || accept_request);
+ assign gpu_error = !reset && !consumer_reset && reject_request;
+
+ wire duplicate_claim = (bank_valid[0] && bank_token[0] == claim_token) ||
+                        (bank_valid[1] && bank_token[1] == claim_token);
+ wire invalid_claim = !result_valid || producer_active || result_success ||
+                      claim_token != generation || result_count == 0 || result_count > 32;
+ wire no_free_bank = &bank_valid;
+ wire claim_bank = bank_valid[0]; // Prefer bank0; called only when one is free.
+ wire accept_claim = claim && !leased && !invalid_claim && !duplicate_claim && !no_free_bank;
+ wire release_match0 = bank_valid[0] && bank_token[0] == gpu_release_token;
+ wire release_match1 = bank_valid[1] && bank_token[1] == gpu_release_token;
+ wire release_match = release_match0 || release_match1;
+ wire release_bank = release_match1;
+ wire release_safe = release_match && bank_ready[release_bank] &&
+                     !(owner && gpu_read_bank == release_bank) &&
+                     !(gpu_req && gpu_token == gpu_release_token);
+
+ always @(posedge clk) begin
+  if (!reset && !consumer_reset && copy_state == COPY_RUN)
+   snapshot_mem[{copy_bank,copy_capture_addr}] <= result_data;
+  // Ownership changes after the grant edge. The existing GPU importer PRIME
+  // state supplies the extra edge before consuming this synchronous output.
+  snapshot_q <= snapshot_mem[{gpu_read_bank,gpu_addr}];
+ end
+
+ always @(posedge clk) begin
+  if (reset) begin
+   generation <= 0;
+   copy_state <= COPY_IDLE;
+   copy_bank <= 0; gpu_read_bank <= 0;
+   copy_issue_addr <= 0; copy_capture_addr <= 0;
+   bank_valid <= 0; bank_ready <= 0;
+   bank_token[0] <= 0; bank_token[1] <= 0;
+   bank_count[0] <= 0; bank_count[1] <= 0;
+   owner <= 0; error <= 0; claim_result <= 0;
+  end else begin
+   // Raw generations advance even while old snapshots are queued/consumed.
+   if (result_success) generation <= generation + 1'b1;
+   if (consumer_reset) begin
+    copy_state <= COPY_IDLE;
+    bank_valid <= 0; bank_ready <= 0;
+    owner <= 0; error <= 0; claim_result <= 0;
+   end else begin
+    if (clear_error) error <= 0;
+    if (accept_request) begin owner <= 1; gpu_read_bank <= gpu_bank; end
+    if (gpu_read_done) owner <= 0;
+    if (reject_request || gpu_fault || producer_rejected) error <= 1;
+    if (gpu_release) begin
+     if (release_safe) begin bank_valid[release_bank] <= 0; bank_ready[release_bank] <= 0; end
+     else error <= 1;
+    end
+    case (copy_state)
+     COPY_WAIT_CPU: if (!cpu_view_active) begin
+      // Switch the address mux only after the accepted CPU burst drains.
+      copy_issue_addr <= 0;
+      copy_state <= COPY_PRIME;
+     end
+     COPY_PRIME: begin
+      // This edge issues raw word0. First capture is the next edge.
+      copy_capture_addr <= 0;
+      copy_issue_addr <= 1;
+      copy_state <= COPY_RUN;
+     end
+     COPY_RUN: begin
+      if (copy_capture_addr == 8'hff) begin
+       bank_ready[copy_bank] <= 1;
+       copy_state <= COPY_IDLE;
+      end else begin
+       copy_capture_addr <= copy_issue_addr;
+       if (copy_issue_addr != 8'hff) copy_issue_addr <= copy_issue_addr + 1'b1;
+      end
+     end
+     default: ;
+    endcase
+    if (claim) begin
+     // Rejection is expected flow control, not a protocol fault. A new
+     // attempt always replaces the mailbox; stale success cannot survive.
+     claim_result <= {26'd0,leased,invalid_claim,no_free_bank,duplicate_claim,2'b00};
+     if (accept_claim) begin
+      claim_result <= {30'd0,claim_bank,1'b1};
+      bank_valid[claim_bank] <= 1;
+      bank_ready[claim_bank] <= 0;
+      bank_token[claim_bank] <= claim_token;
+      bank_count[claim_bank] <= result_count;
+      copy_bank <= claim_bank;
+      copy_state <= COPY_WAIT_CPU;
+     end
+    end
+   end
+  end
+ end
+endmodule
