+ input wire clk, reset_n, enable, soft_reset, ring_reset,
+ input wire [ADDR_BITS-1:0] input_wrptr,
+ output reg [ADDR_BITS-1:0] input_rdptr,
+ output wire [ADDR_BITS-1:0] input_addr,
+ input wire [31:0] input_data,
+ input wire [ADDR_BITS-1:0] output_rdptr, output_addr,
+ output reg [31:0] output_data,
+ output reg [ADDR_BITS-1:0] output_wrptr,
+ output wire busy,
+ output wire view_req,
+ output wire [31:0] view_token,
+ output wire [4:0] view_source,
+ output wire [7:0] view_addr,
+ output reg view_done,
+ input wire view_grant, view_error,
+ input wire [31:0] view_data,
+ output reg view_release, view_fault,
+ output reg [31:0] view_release_token,
+ output wire math_req,
+ input wire math_grant,
+ output reg math_release,
+ output wire math_fma_valid,
+ output wire [31:0] math_fma_a, math_fma_b, math_fma_c,
+ output wire math_fma_multiply,
+ input wire math_fma_result_valid,
+ input wire [31:0] math_fma_result,
+ input wire math_fma_unsupported,
+ output wire math_scratch_read, math_scratch_write,
+ output wire [2:0] math_scratch_read_addr, math_scratch_write_addr,
+ input wire [31:0] math_scratch_data,
+ output wire [31:0] math_scratch_write_data,
+ input wire queue_reg_wr,
+ input wire [9:0] queue_reg_addr,
+ input wire [31:0] queue_reg_wdata,
+ input wire [3:0] queue_reg_wstrb,
+ output reg [31:0] queue_reg_rdata
+);
+ localparam HEADER_PRIME=0, HEADER=1, COPY=2, CONTEXT=3, WAIT_JOBS=4,
+  VIEW_REQUEST=5, VIEW_PRIME=6, JOB_PRIME=7, JOB_CAPTURE=8,
+  MATH_REQUEST=9, CULL_START=10, CULL_WAIT=11, REPAIR=12, NEXT_JOB=13,
+  VERTEX_SELECT=14, VERTEX_PRIME=15, VERTEX_CAPTURE=16, VERTEX_EMIT=17,
+  DRAW_SELECT=18, DRAW_PRIME=19, DRAW_CAPTURE=20, DRAW_HEADER=21,
+  DRAW_WORD=22, RUN_FINISH=23, RELEASE_TOKEN=24, FAULT=25;
+ reg [4:0] state;
+ reg [12:0] remaining, payload_count;
+ reg [2:0] context_index;
+ reg [31:0] token, control_word, u_offset, v_offset, flags_rgb;
+ reg [ADDR_BITS-1:0] job_base, write_ptr;
+ reg [6:0] triangle_count;
+ reg [5:0] job_index;
+ reg [14:0] indices;
+ reg [63:0] keep_mask;
+ reg [31:0] vertex_mask;
+ reg [5:0] vertex_index;
+ reg [2:0] vertex_row;
