+		float alpha = *(const float *)((const byte *)alphas + (size_t)i * stride);
+		float scale = (origin[0] - view_origin[0]) * forward[0] +
+			(origin[1] - view_origin[1]) * forward[1] +
+			(origin[2] - view_origin[2]) * forward[2];
