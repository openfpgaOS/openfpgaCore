+static void
+ofgl_world_cpu(ofgl_world_poly_t *p, int inside, float tw, float th)
+{
+	ofgl_va_vertex.ptr = (const uint8_t *)p->verts;
+	ofgl_va_vertex.size = 3; ofgl_va_vertex.stride = 7 * sizeof(float);
+	ofgl_cvert_t verts[OFGL_WORLD_VERTS];
