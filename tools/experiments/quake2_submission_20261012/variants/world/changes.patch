+    {
+        unsigned n = 7u * packets[i].count - 3u;
+        memcpy(w, packets[i].words, n * sizeof(*w));
+        w += n;
+    }
+    _gpu_ring_commit(words);
+    ofq2_pending = true;
+    return 1;
 }
 
