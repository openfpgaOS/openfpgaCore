+static void check(unsigned vertices, unsigned frames)
+{
+	unsigned xyz = vertices > 40 ? vertices - 7 : vertices;
+	unsigned commands = 3 * vertices + 2;
+	size_t size = sizeof(dmdl_t) + frames * (40 + xyz * 4) + commands * 4;
