+    if(__builtin_expect(sm64_perf_detail_active,0))sm64_perf_enter(bucket);
+    return 0;
+}
+static inline void sm64_perf_scope_end(unsigned *unused) {
+    (void)unused;
+    if(__builtin_expect(sm64_perf_detail_active,0))sm64_perf_leave();
+}
