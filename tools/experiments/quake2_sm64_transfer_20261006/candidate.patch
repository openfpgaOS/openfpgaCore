+#!/usr/bin/env python3
+"""Exercise actual candidate manager + extracted lifecycle under ASan/UBSan."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+
+
+def function(text, name):
+    match = re.search(r"(?m)^(?:static )?(?:void|int)\n" + re.escape(name) + r"\([^;]*?\)\n\{", text)
+    if not match:
+        raise ValueError("Function not found: " + name)
+    # Mask comments/string literals without altering offsets before brace scan.
+    mask = re.sub(r'/\*.*?\*/|//[^\n]*|"(?:\\.|[^"\\])*"',
+                  lambda m: " " * len(m.group()), text, flags=re.S)
+    start = text.index("{", match.start())
+    depth = 1
+    end = start + 1
+    while depth:
+        depth += (mask[end] == "{") - (mask[end] == "}")
+        end += 1
+    return text[match.start():end] + "\n"
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("candidate_root", type=Path)
+    parser.add_argument("--report", type=Path)
+    args = parser.parse_args()
+    root = args.candidate_root.resolve()
+    emit_path = root / "src/quake2/openfpga/of_emit_q2.c"
+    source = emit_path.read_text()
+    names = ["ofq2_texture_route_sdram", "OFQ2_Init", "OFQ2_TexInit", "OFQ2_TexReset",
+             "OFQ2_TexCreate", "OFQ2_TexBindDomain", "OFQ2_Shutdown"]
+    extracted = "\n".join(function(source, name) for name in names)
+    with tempfile.TemporaryDirectory(prefix="quake2-texture-") as temp:
+        work = Path(temp)
+        (work / "extracted_texture_functions.inc").write_text(extracted)
+        exe = work / "texture_test"
+        cmd = [os.environ.get("CC", "cc"), "-std=c11", "-O1", "-g",
+               "-fsanitize=address,undefined", "-fno-omit-frame-pointer", "-fno-pie", "-no-pie",
+               "-I" + str(work), "-I" + str(root / "src/sdk/include"),
+               "-I" + str(root / "src/quake2/openfpga"),
+               str(HERE / "tests/quake2_texture_test.c"), "-o", str(exe)]
+        subprocess.run(cmd, check=True)
+        result = subprocess.run([str(exe)], capture_output=True, text=True,
+                                env=dict(os.environ, ASAN_OPTIONS="detect_leaks=0",
+                                         UBSAN_OPTIONS="halt_on_error=1"))
+        if result.returncode:
+            raise RuntimeError("Texture helper test failed:\n" + result.stdout + result.stderr)
+    print(result.stdout, end="")
+    if args.report:
+        inputs = [emit_path, root / "src/sdk/include/of_texture.h",
+                  root / "src/quake2/openfpga/of_emit_q2.h", root / "src/sdk/include/of_caps.h",
+                  HERE / "tests/quake2_texture_test.c", Path(__file__)]
+        args.report.write_text(json.dumps({"passed": True, "candidate_root": str(root),
+            "test_stdout": result.stdout, "extracted_functions": names,
+            "extracted_sha256": hashlib.sha256(extracted.encode()).hexdigest(),
+            "inputs": {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in inputs},
+            "limitations": ["Records MMIO leaf actions; not a cycle-accurate GPU/cache model.",
+                            "Does not prove device FPS or sustained performance."]}, indent=2) + "\n")
+
+
+if __name__ == "__main__":
+    main()
--- a/tools/tests/quake2_texture_test.c
+++ b/tools/tests/quake2_texture_test.c
@@ -0,0 +1,196 @@
+/* Real non-OF_PC texture manager and extracted Quake2 lifecycle functions.
+ * Hardware leaves are recording mocks; no cached/uncached coherency emulation. */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define OF_GPU_H
+#define OF_CACHE_H
+#include "of_caps.h"
+#include "of_emit_q2.h"
+
+static struct of_capabilities caps;
+const struct of_capabilities *_of_caps_ptr = &caps;
+static uint32_t GPU_PALOOKUP_BASE, GPU_STATUS;
+typedef struct { uint32_t addr; uint16_t width, height; } of_gpu_texture_t;
+static unsigned char fast_bytes[4096];
+static char events[1024];
+static unsigned event_count, route, finish_count, upload_count, clean_count;
+static unsigned pending, expected_live_top;
+static void event(char c) { assert(event_count + 1 < sizeof(events)); events[event_count++] = c; events[event_count] = 0; }
+static void clear_events(void) { event_count = 0; events[0] = 0; }
+static void of_gpu_finish(void);
+static void _of_gpu_route_fast_tex(int enable)
+{
+    assert(!pending);
+    route = enable != 0;
+    event(enable ? 'T' : 'S');
+}
+static void _of_gpu_fast_tex_upload(uint32_t off, const uint32_t *src, uint32_t words)
+{
+    assert(off % 4 == 0 && off + words * 4 <= sizeof(fast_bytes));
+    /* Explicit word reads preserve the actual leaf's source access size. */
+    for (uint32_t i = 0; i < words; ++i) {
+        uint32_t word = src[i];
+        memcpy(fast_bytes + off + i * 4, &word, 4);
+    }
+    ++upload_count;
+    event('U');
+}
+static void of_gpu_bind_texture(const of_gpu_texture_t *tex) { (void)tex; event('B'); }
+static void of_cache_flush_range(void *src, uint32_t bytes) { (void)src; (void)bytes; }
+#include "of_texture.h"
+
+static uint32_t ofq2_caps, ofq2_tex_generation;
+static bool ofq2_ready, ofq2_pending;
+static uint8_t *ofq2_bound_fb;
+static int ofq2_bound_stride;
+static ofq2_tri_state_t ofq2_tristate_cur;
+static bool ofq2_tristate_valid, ofq2_tristate_dirty;
+static ofq2_object_state_t ofq2_objstate_cur;
+static bool ofq2_objstate_valid;
+static uint32_t ofq2_clean_once_slots[4], ofq2_clean_once_hash[4], ofq2_clean_once_next;
+#define OF_SVC_MAGIC 0x4f535643u
+static struct { unsigned magic, count; void *video_acquire_next, *video_buffer_addr; } services;
+#define OF_SVC (&services)
+
+static void of_gpu_init(void) { pending = 0; event('I'); }
+static void of_gpu_finish(void)
+{
+    if (pending) assert(_of_tex_fast_top == expected_live_top);
+    pending = 0;
+    ++finish_count;
+    event('F');
+}
+static void of_gpu_shutdown(void) { assert(!pending); event('D'); }
+void OFQ2_Finish(void) { of_gpu_finish(); ofq2_pending = false; }
+void OFQ2_CacheClean(const void *src, uint32_t bytes)
+{
+    assert(src && bytes);
+    ++clean_count;
+    event('C');
+}
+#include "extracted_texture_functions.inc"
+
+static void setup(uint32_t bytes, uint32_t version)
+{
+    memset(&caps, 0, sizeof(caps));
+    caps.version = version;
+    caps.tex_fast_size = bytes;
+    caps.gpu_base = 0x40000000u;
+    caps.hw_features = OF_HW_GPU_SPAN;
+    route = 1; /* hardware soft reset deliberately leaves the route latched */
+    pending = 0;
+    clean_count = finish_count = upload_count = 0;
+    clear_events();
+    memset(fast_bytes, 0xa5, sizeof(fast_bytes));
+    assert(OFQ2_Init(640));
+    assert(ofq2_ready && ofq2_bound_stride == 640);
+    assert(strcmp(events, version >= 3 && bytes ? "IS" : "I") == 0);
+    if (version >= 3 && bytes) assert(route == 0 && _of_tex_bound == 0);
+    clear_events();
+}
+
+static void test_exact_sizes(void)
+{
+    for (unsigned n = 1; n <= 65; ++n) {
+        setup(4096, 4);
+        unsigned char *src = malloc(n); /* exact allocation: ASan checks tails */
+        assert(src);
+        for (unsigned i = 0; i < n; ++i) src[i] = (unsigned char)(i * 37u + n);
+        ofq2_texture_t t;
+        OFQ2_TexCreate(&t, src, 1, 1, n);
+        assert(clean_count == 1 && events[0] == 'C');
+        assert((t.flags & _OF_TEX_FAST) && t.addr == 0);
+        assert(memcmp(fast_bytes, src, n) == 0);
+        for (unsigned i = n; i < (n + 3u) / 4u * 4u; ++i) assert(fast_bytes[i] == 0);
+        assert(fast_bytes[(n + 3u) / 4u * 4u] == 0xa5);
+        assert(_of_tex_fast_top == ((n + 15u) & ~15u));
+        assert(upload_count == (n / 4u != 0) + (n % 4u != 0));
+        free(src);
+    }
+    puts("PASS: 65 exact source lengths, padded tails, alignment, one clean per create");
+}
+
+static void test_capacity_and_versions(void)
+{
+    unsigned char *src = malloc(45);
+    memset(src, 0x35, 45);
+    ofq2_texture_t a, b;
+    setup(64, 4);
+    OFQ2_TexCreate(&a, src, 1, 1, 45);
+    assert(a.flags & _OF_TEX_FAST);
+    assert(_of_tex_fast_top == 48 && of_texture_budget_free() == 16);
+    unsigned uploads = upload_count;
+    OFQ2_TexCreate(&b, src, 1, 1, 17);
+    assert(!(b.flags & _OF_TEX_FAST) && upload_count == uploads);
+    assert(_of_tex_fast_top == 48);
+    assert(b.addr == (uint32_t)(uintptr_t)src);
+    for (unsigned version = 2; version <= 4; ++version) {
+        setup(version == 2 ? 4096 : 0, version);
+        assert(!of_texture_has_fast_mem());
+        OFQ2_TexCreate(&a, src, 1, 1, 45);
+        assert(a.flags == 0 && upload_count == 0);
+        clear_events();
+        OFQ2_Shutdown();
+        assert(strcmp(events, "FD") == 0); /* no fast-register write */
+    }
+    free(src);
+    puts("PASS: bounded capacity fallback and caps v2/v3/v4 SDRAM-only lifecycle");
+}
+
+static void test_lifecycle_and_domains(void)
+{
+    unsigned char *src = malloc(17);
+    memset(src, 0x91, 17);
+    ofq2_texture_t a;
+    setup(4096, 4);
+    OFQ2_TexCreate(&a, src, 1, 1, 17);
+    clear_events();
+    OFQ2_TexBindDomain(&a);
+    assert(strcmp(events, "FT") == 0 && route == 1);
+    clear_events();
+    OFQ2_TexBindDomain(&a);
+    assert(event_count == 0); /* no per-draw fence for the common domain */
+    expected_live_top = _of_tex_fast_top;
+    pending = 1;
+    unsigned generation = ofq2_tex_generation;
+    OFQ2_TexReset();
+    assert(strcmp(events, "F") == 0);
+    assert(_of_tex_fast_top == 0 && ofq2_tex_generation == generation + 1);
+    /* New offsets may now overwrite old bytes; old handles are invalid. */
+    OFQ2_TexCreate(&a, src, 1, 1, 17);
+    assert(a.addr == 0);
+    clear_events();
+    OFQ2_TexBindDomain(&a);
+    assert(strcmp(events, "FT") == 0); /* reset invalidates route/cache shadow */
+    clear_events();
+    expected_live_top = _of_tex_fast_top;
+    pending = 1;
+    OFQ2_TexInit();
+    assert(strcmp(events, "FS") == 0);
+    assert(route == 0 && _of_tex_fast_top == 0);
+    OFQ2_TexCreate(&a, src, 1, 1, 17);
+    OFQ2_TexBindDomain(&a);
+    clear_events();
+    expected_live_top = _of_tex_fast_top;
+    pending = 1;
+    OFQ2_Shutdown();
+    assert(strcmp(events, "FSD") == 0);
+    assert(!ofq2_ready && route == 0);
+    clear_events();
+    OFQ2_TexInit(); OFQ2_TexReset(); OFQ2_Shutdown();
+    assert(event_count == 0); /* idle wrappers do not touch uninitialized GPU */
+    free(src);
+    puts("PASS: startup stale route, reset/reinit drain-before-reuse, shutdown route, stable binds");
+}
+
+int main(void)
+{
+    test_exact_sizes();
+    test_capacity_and_versions();
+    test_lifecycle_and_domains();
+    return 0;
+}
--- a/docs/sm64-os30-transfer-20261006.txt
+++ b/docs/sm64-os30-transfer-20261006.txt
@@ -0,0 +1,104 @@
+SM64 / os30 findings transferred to Quake2, 2026-10-06
+
+What is already present
+
+Quake2's active GL1 renderer already places static RGB565 textures in the
+capability-reported dedicated texture tier. It already reuses transformed
+vertices, uses compact sticky GPU state, and keeps one GPU submit owner.
+Fast-resident GL1 textures free their SDRAM copies. SM64's resident texture
+allocator and permanent SDRAM fallback therefore cannot be copied here.
+Quake2 retains its current core, OS, clocks, rendering math and capability gates.
+The packaged os30 core is b4d55466283320c798047effa1dd9895d990fd6f297857e52ad99ec9bbf3778d;
+it differs from SM64's retained A core d3d90e20c7116304108a2f94b65d3a69335347603fab388b905cafc3fc6f5f9f.
+The OS matches 054abd4b3d2c57d55b4ecec23f2fcaa3703206db3df14ebe7793c22941d34ef7.
+No core swap is justified without checking Quake2's required capabilities and
+actual rendering on that core. Configured clock is not proof of timing closure.
+
+Applied normal-build changes
+
+- Remove three duplicate texture cache flush/readbacks in the mini-GL layer.
+  OFQ2_TexCreate still performs the visibility handoff exactly once. This cuts
+  upload-time work; no sustained frame-rate improvement has been measured.
+- Pad partial final upload words instead of reading beyond the source. A
+  1x1 RGB565 texture has only two bytes, while the physical upload port takes
+  four-byte words. Aligned upload bodies retain their single-call path.
+- Restore SDRAM texture routing after initialization and before shutdown,
+  since GPU reset alone does not reset that persistent route register.
+- Drain queued references before texture allocator reset/reinitialization.
+  Existing mixed-domain bind fences remain necessary. GL1 does not reset its
+  allocator while fast-only handles are live; that ownership model is retained.
+
+Diagnostics: opt-in and separate from the normal package
+
+  make -C src/quake2 GPU_PROFILE=1
+
+produces build/diagnostics/quake2-gpuprofile.elf and keeps the normal packaged
+quake2.elf unchanged. GPU_PROFILE=0 is the default, using .obj/quake2;
+GPU_PROFILE=1 uses .obj/quake2-gpuprofile. Only 0 and 1 are accepted.
+A fresh full-ELF comparison proved adding these hooks with profiling disabled
+was byte-identical to the pre-update source build before the texture changes.
+
+Use the diagnostic ELF in place of the game ELF only for a measurement. Enter
+normal gameplay, stay in the desired area for at least five seconds, then
+hold L+R and press Select. The Q2 P1 GPU SNAPSHOT panel freezes the latest
+complete two-second window. Repeat the chord to hide it and resume collection;
+allow another complete window before taking another snapshot. Menus, loading screens, pauses and cinematics
+reset collection. This update does not deploy the diagnostic to an SD card.
+
+All times are milliseconds per rendered frame, truncated to 0.1 ms:
+- FPS/FRAME: elapsed end-of-frame intervals, including game/audio/presentation.
+- RING/DMA/FENC: disjoint blocked SDK episodes. Two timer reads per blocked
+  episode, zero timer reads on ready wait paths. Poll counts are not time.
+- COPY: two timer reads per submitted batch, never per command word. In MODE
+  CPU it includes staging loads, serial command MMIO stores, status check and
+  publish. In MODE DMA it measures source copy/cache visibility preparation;
+  descriptor and idle blocking are in DMA, not COPY.
+- WORDS/BATCH: averages per frame; TEX FREE: remaining dedicated arena space.
+
+No new GPU barrier is inserted for measurement. The overlay draws only after
+collection stops, so its CPU text blits do not contaminate the captured window.
+Timers and counter updates can still change measured execution; compare the
+normal executable separately. FENC omits application/kernel presentation waits.
+Texture/LUT uploads, translucency-table waits, nonblocking probes and game/CPU
+work are not classified here. Zero RING does not establish GPU idleness or
+prove the CPU/SDRAM/command-port path is free of stalls. Do not add overlapped
+CPU and GPU component times to predict FPS.
+
+Evidence that motivated the transfer
+
+SM64 F6 single Pocket MAP9 snapshot: 27.4 FPS, 26.6 ms render, 29.9 Hz simulation;
+prior F5: 22.2 FPS, 33.8 ms render. This clears the 25 FPS target for that
+snapshot. It was not a controlled same-state repeated A/B and does not establish
+an equivalent Quake2 improvement. F6 enabled fast texture memory already
+present in Quake2. GPU component replays predicted only 2.5-2.8%, which must not
+be presented as a complete physical frame model.
+
+SM64 F7 snapshot: 21.8 FPS, 34.8 ms render/HOST, explicit ring/DMA/fence/acquire
+waits each below the 0.1 ms display resolution; three sampled frames showed
+12.2 ms vertex and 20.6 ms triangle preparation/submission. HOST includes cache
+stalls and command-store latency, not just arithmetic. Its observed FPS differs
+from F6, confounded by scene and instrumentation; the modeled 0.84% overhead is
+not a physical guarantee. Batched command transfer timing addresses this gap.
+
+Keep the simple core as the reference. Dual issue, geometry workers and faster
+clock experiments did not establish reliable end-to-end gains for the measured
+SM64 scene. Do not enable them by analogy. Division was a smaller full-frame
+contributor than preparation, cache behavior and transport. Preserve Quake2's
+existing float math and texture/material behavior; retained hardware FMA differs
+from IEEE functional simulation, so numerical equivalence needs real evidence.
+
+Reproducible focused checks (run from repository root)
+
+  python3 tools/check_quake2_renderer.py
+  python3 tools/check_quake2_textures.py . --report /tmp/q2-textures.json
+  python3 tools/check_quake2_gpu_profile.py . . /tmp/q2-gpu-profile-tests
+
+The texture helper suite uses ASan/UBSan, exact source lengths 1-65, capacity
+fallback, old capabilities, lifecycle ordering and stable-domain bindings.
+The profiling tests exercise actual extracted SDK/helper code with recording
+MMIO/timer substitutes: poll order, ready paths, blocked episodes, batched
+transport, counter wrap, frozen overlay, window units and chord release.
+Existing eight renderer/loader/audio regression suites pass. Normal and
+separate diagnostic RISC-V builds pass with the existing pinned GCC13.2.0.
+These tests do not simulate an entire Quake2 level or prove device FPS. No FPGA
+fits, timing sweep, clock change, SD deployment or git commit was performed.
