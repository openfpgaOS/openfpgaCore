+   SCRATCH_MUL:begin fma_a=scratch_data;fma_multiply_only=1;end
+   SCRATCH_ADD:begin fma_a=32'h3f800000;fma_b=scratch_data;fma_c={~held_operand[31],held_operand[30:0]};end
+   default:;
+  endcase
+ end
