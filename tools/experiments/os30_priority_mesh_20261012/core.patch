+    endcase
+    if(fma_result_valid)begin
+     bad<=bad|fma_unsupported;
+     if(tags[6]==7)begin
+      cross_bits<=fma_result;unsupported<=bad|fma_unsupported;
+      reject_class<=((fma_result[30:0]==0)||(mode==1?fma_result[31]:!fma_result[31]))?2:0;
