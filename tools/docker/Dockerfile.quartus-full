# syntax=docker/dockerfile:1.6
# openfpgaOS — Quartus container WITH Quartus baked in.
#
# Differs from the bind-mount Dockerfile: instead of borrowing the host's
# Quartus install via -v, this image extracts and runs the Altera Quartus
# offline installer tarball (Quartus-{lite,standard}-*.tar) the contributor
# placed under tools/.  Built locally on each machine via `make quartus-image`;
# the image is NOT redistributable (Intel/Altera Quartus EULA) — keep it on
# your local Docker daemon.
#
# Works with both Lite (free, no license) and Standard editions — same tar
# structure (setup.sh → components/QuartusXSetup-*.run), same Bitrock-style
# unattended flags.  Installs to a generic /opt/altera so the runtime path
# is stable regardless of edition or version.
#
# Pinned to linux/amd64 because Quartus is x86_64-only — on Apple Silicon
# the image runs under Rosetta via Docker Desktop / OrbStack, fast enough
# in practice for the ~7 min fits.  Each container still gets private $HOME
# and /tmp, so concurrent fits remain segfault-free.
#
# The offline tarball is ~9 GB; BuildKit bind-mounts it (never lands in a
# layer), and the install runs ~3-5 min off local disk — no network needed
# during the bake.
FROM --platform=linux/amd64 ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
# Runtime libs Quartus's command-line tools link against, plus what the
# installer itself needs (libnss3 + libxshmfence1 for some installer dialogs
# even in unattended mode; bash for setup.sh's shebang loop).
RUN apt-get update && apt-get install -y --no-install-recommends \
      libglib2.0-0 libsm6 libice6 libxext6 libxrender1 libxft2 libxt6 \
      libxmu6 libxi6 libxtst6 libxfixes3 libxcursor1 libxinerama1 \
      libxrandr2 libxdamage1 libxcomposite1 libfontconfig1 libfreetype6 \
      libgl1 libglu1-mesa zlib1g libpng16-16 \
      libnss3 libxshmfence1 \
      ca-certificates \
      locales make file perl-base \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

# Extract the offline tarball into /tmp via BuildKit bind mount (the .tar
# never lands in an intermediate image layer), then run the Bitrock installer
# inside.  setup.sh forwards args to components/QuartusXSetup-*.run with
# these standard Bitrock unattended flags:
#
#   --mode unattended            no UI, batch install
#   --unattendedmodeui none      suppress any residual progress dialogs
#   --installdir <path>          install root (creates quartus/, nios2eds/, …
#                                directly under it).  We use /opt/altera so
#                                the runtime ENV below is edition-agnostic.
#   --accept_eula 1              re-accept (user already accepted on download)
#
# After the same RUN finishes, /tmp/* is gone but the install at /opt/altera
# persists in this layer.
ARG QUARTUS_TAR
RUN --mount=type=bind,source=${QUARTUS_TAR},target=/tmp/quartus.tar.ro \
    mkdir -p /tmp/qsrc && \
    tar -xf /tmp/quartus.tar.ro -C /tmp/qsrc && \
    bash /tmp/qsrc/setup.sh \
        --mode unattended \
        --unattendedmodeui none \
        --installdir /opt/altera \
        --accept_eula 1 && \
    rm -rf /tmp/qsrc && \
    test -x /opt/altera/quartus/bin/quartus_map \
        || { echo "ERROR: quartus_map missing after install"; ls -la /opt/altera/ 2>&1 || true; exit 1; }

# Rosetta / OrbStack x86_64 emulator workaround for Apple Silicon hosts.
# The undocumented x87 instruction `ffreep st(0)` (opcode df c0) is not
# emulated and raises SIGILL — Quartus's bundled SQLite emits it as cleanup
# after `fucomip` in the compiler-generated FP-compare pattern inside
# hasHighPrecisionDouble(), called from altr_sqlite3_initialize(), so the
# very first FP compare during tool startup crashes.  We patch IN PLACE:
# replace the 2-byte `df c0` (ffreep st(0)) with `dd d8` (fstp st(0)).
# Both pop the FPU stack; fstp additionally stores st(0) to st(0) (no-op).
# Net effect is identical for the post-compare cleanup pattern, and `dd d8`
# is fully documented and emulated correctly.  No-op on native x86_64 Linux
# (just costs the perl invocation).
#
# Scope is intentionally narrow: only the .text section of libccl_sqlite3.so.
# A broader find-and-patch over the whole tree corrupts data bytes (e.g.,
# device-part name tables in libddb_*.so) that coincidentally match df c0.
# If other Quartus binaries also hit ffreep, add them to TARGETS one by one.
RUN TARGETS="/opt/altera/quartus/linux64/libccl_sqlite3.so" && \
    for f in $TARGETS; do \
        [ -f "$f" ] || { echo "MISSING: $f"; exit 1; }; \
        before=$(perl -e 'local $/; open my $h,q{<},$ARGV[0]; binmode $h; my $d=<$h>; print scalar(()=$d=~/\xdf\xc0/g)' "$f"); \
        perl -pi -e 'BEGIN{binmode STDIN;binmode STDOUT} s/\xdf\xc0/\xdd\xd8/g' "$f"; \
        after=$(perl -e 'local $/; open my $h,q{<},$ARGV[0]; binmode $h; my $d=<$h>; print scalar(()=$d=~/\xdf\xc0/g)' "$f"); \
        echo "  patched $f: $before df-c0 -> $after"; \
    done

ENV QUARTUS_ROOTDIR=/opt/altera/quartus
ENV PATH=/opt/altera/quartus/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
