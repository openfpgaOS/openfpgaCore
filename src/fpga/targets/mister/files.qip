# Generated VexiiRiscv netlist (make cpu) — MiSTer dual-issue variant
# (--decoders=2 --lanes=2; the Pocket keeps single-issue VexiiRiscv.v)
set_global_assignment -name VERILOG_FILE ../../vendor/vexriscv/VexiiRiscv/VexiiRiscv_mister.v
