+/**
+ * One-entry skid buffer between two nodes. up.ready is a register (buffer
+ * empty); while the buffer is empty the transaction passes combinationally,
+ * so an unstalled pipeline keeps full throughput with no added latency.
+ * When down stalls, the word up presents that cycle is captured and replayed.
+ * flush drops the buffered word; the word passing through in the flush cycle
+ * is left to the consumer, exactly as without the buffer.
+ */
+class FetchSkidLink(val up : Node, val down : Node, flush : => Bool) extends Link {
+  down.up = this
+  up.down = this
+
+  override def ups: Seq[Node] = List(up)
+  override def downs: Seq[Node] = List(down)
+
+  override def propagateDown(): Unit = {
+    propagateDownAll()
+    down.valid
+  }
+  override def propagateUp(): Unit = {
+    propagateUpAll()
+    up.ready
+  }
+
+  override def build(): Unit = {
+    assert(down.ctrl.forgetOne.isEmpty && down.ctrl.cancel.isEmpty, "FetchSkidLink consumer must not request forgetOne/cancel")
+    val matches = down.fromUp.payload.intersect(up.fromDown.payload)
+
+    val rValid = RegInit(False) setCompositeName(this, "rValid")
+    val rData = matches.map(e => RegNextWhen(up(e), !rValid).setCompositeName(up(e), "skidBuffer"))
+
+    up.ready := !rValid
+    down.valid := up.isValid || rValid
+    when(rValid) {
+      (matches, rData).zipped.foreach(down(_) := _)
+    } otherwise {
+      matches.foreach(e => down(e) := up(e))
+    }
+
+    rValid setWhen(up.isValid) clearWhen(down.ready) clearWhen(flush)
+  }
+}
