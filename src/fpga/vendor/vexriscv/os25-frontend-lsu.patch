 /**
+ * Return address stack pointer recovery (implemented by the BtbPlugin when it has a RAS).
+ * RAS_PTR travels with each instruction : the RAS push pointer of its first fetch word, before that word's
+ * own speculative push/pop. Plugins which flush younger instructions and restart the fetch create a restore
+ * port (age based priority, bigger win) and drive it with the pointer value the fetch should resume with.
+ */
+case class RasRestoreCmd(ptrWidth : Int) extends Bundle {
+  val ptr = UInt(ptrWidth bits) // Push pointer the fetch resumes with
+  val doPush = Bool() // The restoring instruction is a call : (re)write its return address on the new top of the stack
+  val pushPc = Global.PC() // That return address
+}
+
