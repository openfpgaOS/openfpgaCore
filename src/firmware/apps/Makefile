# Application ELFs are built in the SDK repo (openfpgaOS-SDK).
# This directory contains pre-built ELFs copied from the SDK.
# To update: build in the SDK, then run publish.sh.

all:
	@echo "Apps are pre-built (from SDK). Nothing to compile."

clean:
	@echo "Nothing to clean (pre-built ELFs)."

