# openfpgaOS PC Build (SDL2)
#
# Apps use standard SDL2 directly, and openfpgaOS of_* calls are backed by
# the SDL2 simulator in pc/of_sdl2.c.
#
# Usage from an app directory:
#   make -f ../../api/Makefile.pc APP=myapp SRCS="main.c util.c"
#
# Environment:
#   OF_DATA_DIR  - directory for data slot files (default: ./data)

CC ?= cc
API_DIR := $(dir $(lastword $(MAKEFILE_LIST)))

# SDL2 flags
SDL_CFLAGS := $(shell sdl2-config --cflags 2>/dev/null || pkg-config --cflags sdl2 2>/dev/null)
SDL_LIBS   := $(shell sdl2-config --libs 2>/dev/null || pkg-config --libs sdl2 2>/dev/null)

APP ?= app
SRCS ?= main.c
PC_BACKEND := $(API_DIR)/pc/of_sdl2.c

CFLAGS += -DOF_PC -I$(API_DIR) -O2 -g -Wall -Wextra $(SDL_CFLAGS)
CFLAGS += -falign-functions=64 -falign-loops=64
CFLAGS += -fno-tree-loop-distribute-patterns
LDFLAGS += $(SDL_LIBS) -lm

all: $(APP)

$(APP): $(SRCS) $(API_DIR)/of.h $(PC_BACKEND)
	$(CC) $(CFLAGS) -o $@ $(SRCS) $(PC_BACKEND) $(LDFLAGS)

clean:
	rm -f $(APP)

.PHONY: all clean
